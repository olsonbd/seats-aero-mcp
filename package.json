{
  "name": "@olsonbd/seats-aero-mcp",
  "version": "0.2.0",
  "description": "Personal-use MCP server for the Seats.aero Partner API",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seats.aero",
    "award-travel",
    "travel"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olsonbd/seats-aero-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/olsonbd/seats-aero-mcp/issues"
  },
  "homepage": "https://github.com/olsonbd/seats-aero-mcp#readme",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "seats-aero-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "tsx --test test/*.test.ts",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
